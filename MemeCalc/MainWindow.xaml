<Window x:Class="MemeCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemeCalc"
        mc:Ignorable="d"
        Title="Freedom Units Converter"
        Width="350" Height="570"
        MinWidth="200" MinHeight="570"
        ResizeMode="CanResize"
        Background="#990047AB"
        Icon="Icons/flag.png"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="10" >
        
        <Grid.Background>
            <ImageBrush ImageSource="/beige-paper.png"
                         TileMode="Tile"
                         Viewport="0,0,64,64"
                         ViewportUnits="Absolute"
                         Opacity="0.2"
                         Stretch="None"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Result -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Subtitle -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Spacer -->
            <RowDefinition Height="Auto"/> <!-- Row 3: From Label-->
            <RowDefinition Height="Auto"/> <!-- Row 4: Spacer -->
            <RowDefinition Height="Auto"/> <!-- Row 5: To Label -->
            <RowDefinition Height="Auto"/> <!-- Row 6: Spacer -->
            <RowDefinition Height="Auto"/> <!-- Row 7: TextBox -->
            <RowDefinition Height="*"/> <!-- Row 8: Numpad -->
        </Grid.RowDefinitions>

        <Border Background="#FF0047AB" CornerRadius="12" Padding="10" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Label Grid.Row="0"
                   Content="{Binding Result}"
                   FontSize="18"
                   Background="White" 
                   Height="56"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   HorizontalAlignment="Stretch"/>
        </Border>
        <Label Grid.Row="1" Content="Because metric is for communists" Foreground="Silver" FontStyle="Italic" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="10"/>
        <Label Grid.Row="2" Height="30" HorizontalAlignment="Stretch"/>
        <Grid Grid.Row="3" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Height="50" Content="FROM" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="30"/>
            <Border Grid.Column="1" Background="#FF0047AB" CornerRadius="12" Padding="2" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <ComboBox ItemsSource="{Binding AvailableUnits}"
                          SelectedItem="{Binding SelectedFromUnit, Mode=TwoWay}"
                          Height="46"
                          Background="White"
                          BorderThickness="0"
                          Margin="2"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,5,0"
                                       Source="{Binding IconPath}"
                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
            
            
        </Grid>
        <Label Grid.Row="4" Height="20"/> <!-- Spacer -->
        <Grid Grid.Row="5" Margin="0, 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Height="50" Content="TO" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="30"/>
            <Border Grid.Column="1" Background="#FF0047AB" CornerRadius="12" Padding="2" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <ComboBox Height="46"
                          ItemsSource="{Binding AvailableUnits}"
                          SelectedItem="{Binding SelectedToUnit, Mode=TwoWay}"
                          Background="White" 
                          BorderThickness="0" 
                          Margin="2" 
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,5,0"
                                       Source="{Binding IconPath}"
                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
        </Grid>
        <Label Grid.Row="6" Height="20"/> <!-- Spacer -->
        <Border Grid.Row="7" Background="White" CornerRadius="10" Padding="2" Margin="5"> 
            <TextBox Height="50"
                     Text="{Binding InputValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" 
                     TextAlignment="Center" 
                     Background="Transparent" 
                     HorizontalAlignment="Stretch" 
                     Padding="8" 
                     BorderThickness="0" 
                     FontSize="16"/>
        </Border>
        
        <UniformGrid Grid.Row="8" Columns="4" Rows="3" Margin="0,10,0,0">
            <Button Style="{StaticResource NumpadButtonStyle}" Content="1" Command="{Binding AppendInputCommand}" CommandParameter="1"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="2" Command="{Binding AppendInputCommand}" CommandParameter="2"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="3" Command="{Binding AppendInputCommand}" CommandParameter="3"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="4" Command="{Binding AppendInputCommand}" CommandParameter="4"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="5" Command="{Binding AppendInputCommand}" CommandParameter="5"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="6" Command="{Binding AppendInputCommand}" CommandParameter="6"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="7" Command="{Binding AppendInputCommand}" CommandParameter="7"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="8" Command="{Binding AppendInputCommand}" CommandParameter="8"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="9" Command="{Binding AppendInputCommand}" CommandParameter="9"/>
            <Button Style="{StaticResource NumpadButtonStyle}" Content="0" Command="{Binding AppendInputCommand}" CommandParameter="0"/>
            
            <Button Style="{StaticResource NumpadButtonStyle}" Content="{Binding CategoryDisplayName}" 
                    Command="{Binding CycleCategoryCommand}" />
            <Button Style="{StaticResource NumpadButtonStyle}" Content="✓" Background="Green" Command="{Binding ConvertCommand}"/>
        </UniformGrid>
    </Grid>
</Window>
